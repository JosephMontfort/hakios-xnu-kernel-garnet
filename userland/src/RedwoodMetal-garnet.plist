<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>com.hakios.metal</string>
	<key>CFBundleName</key>
	<string>RedwoodMetal</string>
	<!-- the bundle the system image links (/System/Library/Extensions/RedwoodMetal.bundle), with hakios-metal's
	     plug-in (src/HakiosMetalCA.m) as its executable -->
	<key>CFBundleExecutable</key>
	<string>RedwoodMetal</string>
	<key>CFBundlePackageType</key>
	<string>BNDL</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>CFBundleSupportedPlatforms</key>
	<array>
		<string>iPhoneOS</string>
	</array>
	<!-- Metal falls back to the principal class when -classNamed: answers nil; RedwoodMetalDevice
	     (src/HakiosMetalAlias.m) is HakiosMetalDevice under the kernel's default name -->
	<key>NSPrincipalClass</key>
	<string>RedwoodMetalDevice</string>
</dict>
</plist>
